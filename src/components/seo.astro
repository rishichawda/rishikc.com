---
import { getCollection } from "astro:content";
import type { ShareImage } from "../utils/shareImage";
import { cardImage } from "../utils/cards";
import { LOCALE } from "../utils/topics";
import { structuredData } from "../utils/siteData";
import {
  buildGraphForPage,
  buildWebPageEntity,
  personRef,
  type ProfileData,
} from "../utils/jsonLd";

interface Social { platform: string; url: string; }
interface Position { title: string; }
interface Experience { company: string; positions: Position[]; website?: string[]; }
interface Certification { institution: string; title: string; }
interface Education { university: string; institution: string; degree: string; }
interface LangEntry { name: string; level: string; }

let {
  page_info: { title, description, image, keywords, type, datePublished, dateModified, tags, noindex, robots: extraRobots, brandSuffix, section, tdmReservation },
  pageSchemaEntities,
} = Astro.props;

const siteOrigin = (Astro.site || new URL("https://rishikc.com")).origin;
const canonicalURL = new URL(
  Astro.url.pathname,
  Astro.site || "https://rishikc.com",
);

// The share image: the page's own, else a generated card (src/pages/og). Both carry their real size and type.
const shareImage: ShareImage = image?.src ? image : cardImage(Astro.url.pathname);
const resolvedImage = shareImage.src.startsWith("http") ? shareImage.src : new URL(shareImage.src, siteOrigin).toString();
// The square icon stands for the author wherever the markup asks for an image of the Person.
const profileImage = new URL("/icons/512.png", siteOrigin).toString();
const imageAlt = shareImage.alt ?? title;

// One robots meta for the page; directives from the caller (for example noimageindex) join it.
// Indexable pages allow large image previews (Discover) and unlimited snippets.
const robotsDirectives = [
  ...(noindex ? ["noindex", "nofollow"] : ["index", "follow", "max-image-preview:large", "max-snippet:-1"]),
  ...(extraRobots ?? []),
];

const profileEntry = await getCollection("profile");
const raw = profileEntry[0].data as any;
const profile: ProfileData = {
  name: raw.name,
  title: raw.title,
  summary: raw.summary,
  location: raw.location,
  socials: raw.socials as Social[],
  certifications: raw.certifications as Certification[],
  education: raw.education as Education[],
  experience: raw.experience as Experience[],
  languages: raw.languages as LangEntry[],
};

const siteDescription = `Personal portfolio, technical articles, photography, and open source projects by ${profile.name}.`;

// Build the @graph for this page
const pageEntities = pageSchemaEntities || [];
const fullGraph = buildGraphForPage({
  profile,
  profileImageUrl: profileImage,
  siteDescription,
  pathname: Astro.url.pathname,
  pageTitle: title,
  pageEntities: pageEntities,
});
// Escape < and > to prevent HTML parser interference with JSON-LD content
const graphJson = JSON.stringify(fullGraph).replace(/</g, '\\u003c').replace(/>/g, '\\u003e');

// OG type: 'article' for articles and bits, 'profile' for the about page, 'website' for the rest
const ogType = type === "article" || type === "profile" ? type : "website";
const githubUser = profile.socials.find((s: Social) => s.platform === "GitHub")?.url.split("/").pop();
const [firstName, , lastName] = profile.name.split(" ");

// Google ignores meta keywords; Bing may read a long list as stuffing. Keep the first 8 distinct terms.
const keywordList = [...new Set((keywords ?? "").split(",").map((k: string) => k.trim()).filter(Boolean))].slice(0, 8).join(", ");
---

<meta charset="UTF-8" />
<title>{brandSuffix ? `${title} | ${profile.name}` : title}</title>
<meta name="viewport" content="width=device-width, initial-scale=1" />
<!-- Browser UI colour; the values are --color-bg in src/styles/global.css -->
<meta name="theme-color" content={structuredData.head.themeColor.light} media="(prefers-color-scheme: light)" />
<meta name="theme-color" content={structuredData.head.themeColor.dark} media="(prefers-color-scheme: dark)" />
<meta name="author" content={profile.name} />
{ogType === "article" ? <link rel="author" href="/about/" /> : null}
<link rel="icon" href="/favicon.ico" sizes="48x48" />
<link rel="icon" type="image/png" sizes="192x192" href="/icons/192.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/manifest.webmanifest" />
<link rel="canonical" href={canonicalURL.toString()} />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title="RSS Feed" href="/rss.xml" />
<meta name="description" content={description} />
{robotsDirectives.length ? <meta name="robots" content={robotsDirectives.join(", ")} /> : null}
<meta name="image" content={resolvedImage} />
{keywordList ? <meta name="keywords" content={keywordList} /> : null}

<!-- Open Graph -->
<meta property="og:title" content={title} />
<meta property="og:site_name" content={profile.name} />
<meta property="og:description" content={description} />
<meta property="og:image" content={resolvedImage} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:image:width" content={shareImage.width} />
<meta property="og:image:height" content={shareImage.height} />
{shareImage.type ? <meta property="og:image:type" content={shareImage.type} /> : null}
<meta property="og:url" content={canonicalURL.toString()} />
<meta property="og:type" content={ogType} />
<meta property="og:locale" content={LOCALE.replace("-", "_")} />
{datePublished ? <meta property="article:published_time" content={datePublished} /> : null}
{dateModified ? <meta property="article:modified_time" content={dateModified} /> : null}
{ogType === "article" ? <meta property="article:author" content="https://rishikc.com/about/" /> : null}
{tdmReservation ? <meta name="tdm-reservation" content="1" /> : null}
{section ? <meta property="article:section" content={section} /> : null}
{ogType === "profile" ? <meta property="profile:first_name" content={firstName} /> : null}
{ogType === "profile" ? <meta property="profile:last_name" content={lastName} /> : null}
{ogType === "profile" && githubUser ? <meta property="profile:username" content={githubUser} /> : null}
{tags?.map((tag: string) => <meta property="article:tag" content={tag} />)}

<!-- Twitter -->
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={resolvedImage} />
<meta name="twitter:image:alt" content={imageAlt} />
<meta name="twitter:site" content="@rishiikc" />
<meta name="twitter:creator" content="@rishiikc" />

<!-- Identity verification -->
{profile.socials.map((social: Social) => (
  <link rel="me" href={social.url} />
))}

<!-- JSON-LD @graph -->
<script type="application/ld+json" set:html={graphJson} />
