---
import { getCollection, render } from "astro:content";
import BlogPost from "../../layouts/article.astro";
import Prose from "../../components/article/prose.astro";
import RelatedArticles from "../../components/article/related_articles.astro";
import BaseLayout from "../../layouts/base_layout.astro";
import TableOfContents from "../../components/article/table_of_contents.astro";
import ExternalLink from "../../components/article/ExternalLink.astro";
import SeriesNavigation from "../../components/article/series_navigation.astro";
import { getSeriesInfo, getSeriesSlug, getSeriesTitle } from "../../utils/seriesUtils";
import { authorRef, blogRef, buildWebPageEntity, websiteRef } from "../../utils/jsonLd";
import { LOCALE, TAG_TOPIC_IDS, entity } from "../../utils/topics";
import { findMentions } from "../../utils/mentions";
import { getImage } from "astro:assets";
import { isPhotograph, previewImage, shareImage } from "../../utils/shareImage";
import "remark-notes-plugin/styles.css";

export async function getStaticPaths() {
	let posts = await getCollection("articles");

	return posts.map((post) => {
		return {
			params: { slug: post.id },
			props: { post, allPosts: posts },
		};
	});
}

const { post, allPosts } = Astro.props;
const { Content, remarkPluginFrontmatter, headings } = await render(post);

// Sort all posts by date for prev/next navigation
const sorted = [...allPosts].sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const currentIndex = sorted.findIndex((p) => p.id === post.id);
const prevPost = currentIndex < sorted.length - 1 ? sorted[currentIndex + 1] : null;
const nextPost = currentIndex > 0 ? sorted[currentIndex - 1] : null;

// Series info
const seriesInfo = getSeriesInfo(post, allPosts);
const seriesTitle = post.data.series ? getSeriesTitle(post.data.series) : "";

// Build JSON-LD entities for the @graph
const articleUrl = new URL(
	post.data.path || Astro.url.pathname,
	Astro.site || "https://rishikc.com",
).toString();
// A hero that is a gallery photograph is blocked by robots.txt, so the share image is a preview of it.
const hero = post.data.hero_image;
const share = isPhotograph(hero)
	? previewImage(`/previews/articles/${post.id}.jpg`, post.data.hero_image_alt)
	: hero ? shareImage(hero, post.data.hero_image_alt) : undefined;
const imageUrl = share ? new URL(share.src, Astro.site || "https://rishikc.com").toString() : "";
const isoDate = post.data.date ? post.data.date.toISOString() : "";
const isoDateModified = post.data.dateModified ? new Date(post.data.dateModified).toISOString() : isoDate;

const siteUrl = Astro.site || "https://rishikc.com";
const absolute = (path: string) => new URL(path, siteUrl).toString();

// Google recommends the same image at 16x9, 4x3 and 1x1 (each at least 50K pixels). A crop never
// upscales: it takes the largest size the hero allows, up to 1200px wide. A hero that is a gallery
// photograph gets none, because its derivatives sit under /_astro/photos/, which robots.txt blocks.
const imageSet = hero && !isPhotograph(hero)
	? (await Promise.all([16 / 9, 4 / 3, 1].map(async (ratio) => {
		const width = Math.min(1200, hero.width, Math.floor(hero.height * ratio));
		const height = Math.round(width / ratio);
		// A small hero (a wide logo, say) cannot make every crop; skip those under 50K pixels.
		if (width * height < 50_000) return null;
		const crop = await getImage({ src: hero, width, height, fit: "cover", format: "jpg" });
		return absolute(crop.src);
	}))).filter((url): url is string => url !== null)
	: [];

const seriesRef = post.data.series
	? {
		"@type": "CreativeWorkSeries",
		"@id": `${absolute(`/articles/series/${getSeriesSlug(post.data.series.title)}/`)}#series`,
		name: post.data.series.title,
		url: absolute(`/articles/series/${getSeriesSlug(post.data.series.title)}/`),
	}
	: null;
const topics = post.data.tags
	.map((tag) => TAG_TOPIC_IDS[tag.toLowerCase()])
	.filter((id, index, ids) => id && ids.indexOf(id) === index)
	.map((id) => entity(id));

// Terms the text uses often (thresholds in content/about/structured-data.json), apart from the topics it is about.
const aboutIds = new Set(post.data.tags.map((tag) => TAG_TOPIC_IDS[tag.toLowerCase()]));
const mentioned = findMentions(post.body ?? "")
	.filter((id) => !aboutIds.has(id))
	.map((id) => entity(id));

const articleEntity: Record<string, unknown> = {
	"@type": post.data.jsonld_schema || "Article",
	"@id": `${articleUrl}#article`,
	url: articleUrl,
	headline: post.data.title,
	description: post.data.description,
	image: imageSet.length ? imageSet : imageUrl,
	...(imageSet.length ? { thumbnailUrl: imageSet.at(-1) } : {}),
	datePublished: isoDate,
	dateModified: isoDateModified,
	author: authorRef,
	publisher: authorRef,
	copyrightHolder: authorRef,
	copyrightYear: post.data.date.getUTCFullYear(),
	isAccessibleForFree: true,
	inLanguage: LOCALE,
	isPartOf: seriesRef ? [websiteRef, blogRef("articles"), seriesRef] : [websiteRef, blogRef("articles")],
	...(seriesRef ? { position: post.data.series!.currentPart } : {}),
	mainEntityOfPage: { "@id": articleUrl },
	keywords: post.data.tags,
	...(topics.length ? { about: topics } : {}),
	...(mentioned.length ? { mentions: mentioned } : {}),
	...(post.data.category ? { articleSection: post.data.category } : {}),
	...(remarkPluginFrontmatter?.wordCount ? {
		wordCount: remarkPluginFrontmatter.wordCount,
		timeRequired: `PT${remarkPluginFrontmatter.readingMinutes}M`,
	} : {}),
	speakable: {
		"@type": "SpeakableSpecification",
		cssSelector: [".article-title", ".article-subtitle", ".article-meta"],
	},
};

const pageSchemaEntities: Record<string, unknown>[] = [
	buildWebPageEntity({
		url: articleUrl,
		name: post.data.title,
		description: post.data.description,
		dateModified: isoDateModified,
		mainEntity: { "@id": `${articleUrl}#article` },
	}),
	articleEntity,
];

// Add FAQ entity if present
if (post.data.faq && post.data.faq.length > 0) {
	pageSchemaEntities.push({
		"@type": "FAQPage",
		"@id": `${articleUrl}#faq`,
		mainEntity: post.data.faq.map((item: { question: string; answer: string }) => ({
			"@type": "Question",
			name: item.question,
			acceptedAnswer: { "@type": "Answer", text: item.answer },
		})),
	});
}
---

<BaseLayout
	page_info={{
		title: post.data.title,
		description: post.data.description,
		image: share,
		// A photograph hero shares a crop of the photo, which crawlers may fetch but must not index.
		robots: isPhotograph(hero) ? ["noimageindex"] : undefined,
		keywords: post.data.keywords,
		type: "article",
		section: post.data.category,
		datePublished: post.data.date.toISOString(),
		dateModified: post.data.dateModified ? new Date(post.data.dateModified).toISOString() : post.data.date.toISOString(),
		tags: post.data.tags,
	}}
	activeRoute="/articles/"
	pageSchemaEntities={pageSchemaEntities}
>
	<div class="article-page">
		<BlogPost content={post.data} frontmatter={remarkPluginFrontmatter}>
			<TableOfContents headings={headings} />
			<Prose>
				<Content components={{ a: ExternalLink }} />
			</Prose>
		</BlogPost>

		<!-- Series Navigation -->
		{seriesInfo && (
			<div class="series-nav-wrapper" aria-label="Series navigation">
				<SeriesNavigation seriesInfo={seriesInfo} seriesTitle={seriesTitle} />
			</div>
		)}

		<!-- Related Articles -->
		<RelatedArticles currentArticle={post} allArticles={allPosts} />

		<!-- Prev / Next Navigation -->
		<nav class="article-nav" aria-label="Article navigation">
			{prevPost ? (
				<a href={prevPost.data.path} class="nav-card prev">
					<span class="nav-label">&larr; Previous</span>
					<span class="nav-title">{prevPost.data.title}</span>
				</a>
			) : <div />}
			{nextPost ? (
				<a href={nextPost.data.path} class="nav-card next">
					<span class="nav-label">Next &rarr;</span>
					<span class="nav-title">{nextPost.data.title}</span>
				</a>
			) : <div />}
		</nav>
	</div>
</BaseLayout>

<style>
	.article-page {
		display: flex;
		flex-direction: column;
		align-items: center;
		padding-top: var(--space-10);
	}

	.series-nav-wrapper {
		max-width: 920px;
		width: 100%;
		padding: 0 var(--space-6);
		margin: 0 auto;
	}

	/* Prev / Next Nav */
	.article-nav {
		max-width: 720px;
		width: 100%;
		margin: 0 auto;
		padding: var(--space-12) var(--space-6) var(--space-20);
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--space-4);
	}
	.nav-card {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		padding: var(--space-5);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: 12px;
		text-decoration: none;
		color: inherit;
		transition: transform 200ms, box-shadow 200ms;
	}
	.nav-card:hover {
		transform: translateY(-2px);
		box-shadow: var(--shadow-elevated);
	}
	.nav-card.next { text-align: right; }
	.nav-label {
		font-family: var(--font-mono);
		font-size: var(--text-caption);
		color: var(--color-text-tertiary);
	}
	.nav-title {
		font-family: var(--font-body);
		font-size: var(--text-body);
		color: var(--color-text);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		transition: color 200ms;
	}
	.nav-card:hover .nav-title { color: var(--color-brand); }

	@media (max-width: 767px) {
		.article-nav {
			grid-template-columns: 1fr;
			padding: var(--space-8) var(--space-4) var(--space-16);
		}
	}
</style>
