---
import BaseLayout from "../layouts/base_layout.astro";
import { getCollection } from "astro:content";
import { Font } from "astro:assets";
import backgroundPhoto from "../../content/gallery/landscape-photography/himalayas.jpg";
import backgroundPhotoDark from "../../content/gallery/landscape-photography/moon-rise-in-himalayas.jpg";
import { AUTHOR_NAME, buildWebPageEntity } from "../utils/jsonLd";

const quotesData = await getCollection("quotes");
const allQuotes = quotesData[1].data;

const page_info = {
    title: "Reads: Quotes Worth Keeping",
    brandSuffix: true,
    description: "A collection of quotes and passages that inspire, provoke thought, or simply resonate with me",
    keywords: "quotes, books, reading, inspiration, Rishi Chawda",
};

const pageUrl = new URL(
    Astro.url.pathname,
    Astro.site || "https://rishikc.com",
).toString();

const pageSchemaEntities = [
    buildWebPageEntity({
        type: "CollectionPage",
        url: pageUrl,
        name: `Reads - ${AUTHOR_NAME}`,
        description: page_info.description,
        mainEntity: {
            "@type": "ItemList",
            numberOfItems: allQuotes.length,
            itemListElement: allQuotes.map((quote: any, index: number) => ({
                "@type": "ListItem",
                position: index + 1,
                item: {
                    "@type": "Quotation",
                    text: quote.quote,
                    author: quote.info ? quote.info.split(",")[0] : undefined,
                },
            })),
        },
    }),
];
---

<BaseLayout page_info={page_info} activeRoute="/reads/" pageSchemaEntities={pageSchemaEntities}>

    <Fragment slot="head">
        <Font cssVariable="--font-source-serif-4" />
        <Font cssVariable="--font-jost" />
    </Fragment>

    <div id="reads-stage" class="stage" data-background={backgroundPhoto.src} data-background-dark={backgroundPhotoDark.src}>
        <canvas id="reads-canvas" class="stage-canvas" aria-hidden="true"></canvas>
        <!-- On touch screens these strips stay out of the swipe, so the browser's own back gesture still works there. -->
        <div class="stage-edge stage-edge-left" data-edge aria-hidden="true"></div>
        <div class="stage-edge stage-edge-right" data-edge aria-hidden="true"></div>
        <section class="page-header" data-reveal>
            <h1 class="page-title">Reads</h1>
            <p class="page-subtitle">A collection of quotes, passages, and ideas that have shaped my thinking.</p>
        </section>
        <div class="stage-loader" aria-hidden="true">
            <div class="loader-cards"><span></span><span></span><span></span></div>
            <p class="loader-caption">Gathering quotes<span class="loader-dots"><i>.</i><i>.</i><i>.</i></span></p>
        </div>
        <p id="reads-live" class="visually-hidden" aria-live="polite"></p>

        <!-- The canvas is not readable by assistive tech, so the quotes also live here, and feed the scene. -->
        <div class="quote-list visually-hidden">
            {allQuotes.map((quote: any) => (
                <blockquote data-quote={quote.quote} data-info={quote.info || ""} data-theme={quote.theme} data-art={quote.art}>
                    <p>{quote.quote}</p>
                    {quote.info && <cite>{quote.info}</cite>}
                </blockquote>
            ))}
        </div>
    </div>
</BaseLayout>

<script>
    type Scene = { dispose(): void };
    let scene: Scene | null = null;

    async function mountStage() {
        const stage = document.getElementById('reads-stage');
        const canvas = document.getElementById('reads-canvas') as HTMLCanvasElement | null;
        const live = document.getElementById('reads-live');
        if (!stage || !canvas || !live) return;

        const quotes = Array.from(document.querySelectorAll<HTMLElement>('.quote-list blockquote')).map((card) => ({
            quote: card.dataset.quote ?? '',
            info: card.dataset.info ?? '',
            theme: card.dataset.theme,
            art: card.dataset.art,
        }));

        const { mount } = await import('../scripts/reads/scene.js');
        if (!stage.isConnected) return;

        // the loading screen goes once the cards fade in, or when there is no WebGL to show them with
        const loaded = () => stage.classList.add('is-loaded');
        scene = mount(stage, canvas, quotes, {
            backgrounds: { light: stage.dataset.background, dark: stage.dataset.backgroundDark },
            onChange: (card: { q: string; a: string }) => {
                live.textContent = card.a ? `${card.q} — ${card.a}` : card.q;
            },
            onBuilt: loaded,
            onFailed: loaded,
        });
        if (!scene) return;
        stage.tabIndex = 0;
        stage.setAttribute('role', 'group');
        stage.setAttribute('aria-label', 'Quote cards. Scroll, swipe, click a card or use the arrow keys to move between quotes.');
    }

    document.addEventListener('astro:before-swap', () => {
        scene?.dispose();
        scene = null;
    });

    document.addEventListener('astro:page-load', mountStage);
</script>

<style>
    /* The nav floats over the stage, so the stage pulls up under it. Over the light photo it keeps dark text until it
       gets its own background on scroll; in dark theme the stage is dark and the nav keeps its default light text. */
    :global([data-theme="light"] .site-header:not(.scrolled)) {
        --color-text: #1c2650;
        --color-text-secondary: #38446d;
        --color-text-tertiary: #38446d;
        --color-brand-dark: #1b2552;
        --color-brand-lighter: rgba(255, 255, 255, 0.35);
    }
    .stage {
        position: relative;
        margin-top: calc(var(--nav-height) * -1);
        height: 100svh;
        min-height: 520px;
        overflow: hidden;
        background: linear-gradient(180deg, #7d9dd0 0%, #c8d6ec 48%, #f2e6dc 72%, #61768a 100%);
    }
    :global([data-theme="dark"]) .stage {
        background: linear-gradient(180deg, #060a16 0%, #16203a 100%);
    }
    .stage:focus-visible {
        outline: 3px solid #1b2552;
        outline-offset: -6px;
    }
    .stage-canvas {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        display: block;
        /* sideways drags move the cards; vertical ones scroll the page */
        touch-action: pan-y;
    }
    .stage-edge {
        display: none;
        position: absolute;
        top: 0;
        bottom: 0;
        width: 20px;
    }
    .stage-edge-left {
        left: 0;
    }
    .stage-edge-right {
        right: 0;
    }
    @media (pointer: coarse) {
        .stage-edge {
            display: block;
        }
    }
    .stage-loader {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 34px;
        pointer-events: none;
        transition: opacity 0.7s ease, visibility 0s linear 0.7s;
    }
    .stage.is-loaded .stage-loader {
        opacity: 0;
        visibility: hidden;
    }
    /* three cards fan out and shuffle back in while the scene starts up */
    .loader-cards {
        position: relative;
        width: 96px;
        height: 88px;
    }
    .loader-cards span {
        position: absolute;
        inset: 0;
        border-radius: 14px;
        background: rgba(255, 255, 255, 0.7);
        border: 1px solid rgba(27, 37, 82, 0.22);
        box-shadow: 0 10px 28px rgba(27, 37, 82, 0.18);
        transform-origin: 50% 120%;
        animation: loader-fan 2.1s cubic-bezier(0.65, 0, 0.35, 1) infinite;
    }
    .loader-cards span:nth-child(1) { --fan: -17deg; }
    .loader-cards span:nth-child(3) { --fan: 17deg; }
    .loader-cards span:nth-child(2) {
        --fan: 0deg;
        animation-name: loader-fan, loader-bob;
        animation-duration: 2.1s, 1.4s;
        animation-timing-function: cubic-bezier(0.65, 0, 0.35, 1), ease-in-out;
    }
    .loader-cards span:nth-child(2)::before {
        content: "\201C";
        position: absolute;
        left: 16px;
        top: 6px;
        font-family: var(--font-source-serif-4, serif);
        font-size: 54px;
        font-weight: 600;
        line-height: 1;
        color: #1b2552;
        opacity: 0.7;
    }
    .loader-caption {
        margin: 0;
        font-family: var(--font-jost);
        font-size: 14px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: #38446d;
        text-shadow: 0 1px 14px rgba(255, 255, 255, 0.8);
    }
    .loader-dots i {
        font-style: normal;
        animation: loader-dot 1.2s ease-in-out infinite;
    }
    .loader-dots i:nth-child(2) { animation-delay: 0.15s; }
    .loader-dots i:nth-child(3) { animation-delay: 0.3s; }
    :global([data-theme="dark"]) .loader-cards span {
        background: rgba(255, 255, 255, 0.08);
        border-color: rgba(255, 255, 255, 0.22);
        box-shadow: 0 10px 28px rgba(0, 0, 0, 0.4);
    }
    :global([data-theme="dark"]) .loader-cards span:nth-child(2)::before,
    :global([data-theme="dark"]) .loader-caption {
        color: #c9d0e6;
    }
    @keyframes loader-fan {
        0%, 100% { transform: rotate(0deg); }
        50% { transform: rotate(var(--fan)); }
    }
    @keyframes loader-bob {
        0%, 100% { translate: 0 0; }
        50% { translate: 0 -6px; }
    }
    @keyframes loader-dot {
        0%, 100% { opacity: 0.2; }
        50% { opacity: 1; }
    }
    @media (prefers-reduced-motion: reduce) {
        .loader-cards span,
        .loader-dots i {
            animation: none;
        }
        .loader-cards span:nth-child(1) { transform: rotate(-17deg); }
        .loader-cards span:nth-child(3) { transform: rotate(17deg); }
    }
    .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        margin: 0;
        padding: 0;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
    }

    .page-header {
        position: absolute;
        top: calc(var(--nav-height) + clamp(16px, 3vh, 40px));
        left: 16px;
        right: 16px;
        text-align: center;
        pointer-events: none;
    }
    .page-title {
        font-family: var(--font-display);
        font-size: clamp(40px, 4.6vw, 72px);
        font-weight: 700;
        line-height: 1.1;
        letter-spacing: -0.025em;
        color: #1b2552;
        text-shadow: 0 2px 28px rgba(255, 255, 255, 0.6);
        margin: 0 0 10px;
    }
    :global([data-theme="dark"]) .page-title {
        color: #f1f3fa;
        text-shadow: 0 2px 28px rgba(0, 0, 0, 0.6);
    }
    :global([data-theme="dark"]) .page-subtitle {
        color: #c9d0e6;
        text-shadow: 0 1px 14px rgba(0, 0, 0, 0.7);
    }
    .page-subtitle {
        max-width: 560px;
        margin: 0 auto;
        font-family: var(--font-jost);
        font-size: clamp(14px, 1.05vw, 17px);
        line-height: 1.5;
        letter-spacing: 0.03em;
        text-wrap: balance;
        color: #38446d;
        text-shadow: 0 1px 14px rgba(255, 255, 255, 0.7);
    }
</style>
